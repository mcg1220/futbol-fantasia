# Copy this to `.env` for local overrides (optional — the app has safe
# defaults for everything here when running locally). On the hosted
# deploy, these get set as real environment variables in the platform's
# dashboard instead of a file — see Phase 2 of the deploy plan.

# A long, random string. Required on any public deploy; the app falls back
# to an insecure placeholder locally if this isn't set.
SECRET_KEY=

# Set to "false" anywhere public-facing. Defaults to "true" (Flask's
# debug/auto-reload mode) if unset, which is fine for local dev but must
# never be true on a host anyone else can reach.
FLASK_DEBUG=true

# Shared secret the hosted cron job sends to /internal/auto-scrape-trigger
# so only that scheduled job (not the public internet) can fire a scrape.
# Not used locally — the in-process poller thread covers local dev instead.
INTERNAL_TRIGGER_SECRET=

# Which port the app listens on. Most hosts set this automatically.
PORT=5000
